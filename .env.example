# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
APP_URL=http://localhost:3000

# YOUTUBE_API_KEY: Optional. Used for direct YouTube search and playlist retrieval.
# Get one at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# GOOGLE_OAUTH: Required for "Sign in with Google" feature.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# 1. WEB CLIENT: Use "Web application" type. For the AI Studio preview, add redirect: <Current App URL>/__/auth/handler
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET_WEB=

# 2. DESKTOP CLIENT: Use "Desktop app" type for the native Electron build.
GOOGLE_CLIENT_ID_DESKTOP=
GOOGLE_CLIENT_SECRET_DESKTOP=

# Enable "YouTube Data API v3" AND "Google Drive API" in the Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
