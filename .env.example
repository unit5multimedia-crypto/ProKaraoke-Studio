# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
APP_URL=http://localhost:3000

# YOUTUBE_API_KEY: Optional. Used for direct YouTube search and playlist retrieval.
# Get one at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# GOOGLE_OAUTH: Required for "Sign in with Google" feature.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add these redirect URIs:
# 1. <App URL>/api/auth/google/callback
# 2. <Shared App URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
